# Sunucu
PORT=4000
NODE_ENV=development

# LLM sağlayıcı — bkz. SDD §1.6: model kimliği koda gömülmez
GEMINI_API_KEY=
MODEL_ID=gemini-3.6-flash

# Cache — bkz. SDD §1.4
CACHE_TTL_WEEKLY_PLAN_SECONDS=86400
CACHE_TTL_QUICK_MEAL_SECONDS=7200
CACHE_MAX_KEYS=5000
STALE_CACHE_TTL_SECONDS=604800

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
