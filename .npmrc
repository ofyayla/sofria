# Metro (Expo/React Native'in bundler'ı), pnpm'in katı (sembolik linkli,
# hoisted olmayan) node_modules yapısını anlamıyor — yalnızca doğrudan
# proje kökü ve workspace kökü node_modules'una bakıyor, .pnpm mağazasının
# iç içe paket klasörlerine hiyerarşik olarak inmiyor.
#
# `shamefully-hoist=true` denendi ama yetmedi: .pnpm mağazasındaki iç içe
# paketlerin (örn. expo-router) KENDİ node_modules'ları hâlâ sembolik link,
# ve Metro'nun Windows'taki "package.json exports" + symlink geri düşüş
# (fallback) mantığında gerçek bir hata var — bozuk bir ara yol üretip
# (.pnpm\node_modules\react\... — paket sürüm segmenti eksik) var olan bir
# dosyayı "yok" sanıyor (bkz. `react/jsx-runtime çözülemedi` hatası).
#
# Kesin çözüm: `node-linker=hoisted` — node_modules'ı npm/yarn classic gibi
# tamamen düz kopyalara çevirir, hiç sembolik link kalmaz, bu hata sınıfı
# tamamen ortadan kalkar. `shamefully-hoist` bu modda anlamsız (zaten flat).
node-linker=hoisted
# node-linker=hoisted yalnızca DİZİN yapısını düzleştiriyor — pnpm yine de
# tek tek DOSYALARI kendi global mağazasından sabit bağlantı (hardlink)
# olarak koyuyor (disk alanı tasarrufu için pnpm'in temel çalışma şekli).
# Metro'nun Windows'taki dosya tarayıcısı hardlink'li dosyalarla düzgün
# çalışmıyor gibi görünüyor (bkz. "Failed to get the SHA-1" hatası, dosya
# gerçekte var ve okunabilir olduğu hâlde). `copy` ile pnpm her dosyayı
# gerçek, bağımsız bir kopya olarak yazıyor — hardlink tamamen ortadan kalkıyor.
package-import-method=copy
